PORT=3000
NODE_ENV=development

# cPanel MySQL Connection (required in production; dev preview falls back to local JSON when blank)
# Note: cPanel MySQL Databases do not allow spaces or apostrophes (') in DB or User names.
# Use the exact prefixed names created in cPanel (e.g. DB_NAME=cpaneluser_inayas_wardrobe, DB_USER=cpaneluser_inayas_wardrobe).
DB_HOST=localhost
DB_PORT=3306
DB_SOCKET=
DB_NAME=
DB_USER=
DB_PASSWORD=

# Authentication & Admin Configuration (AUTH_SECRET must be >= 32 random chars in production)
AUTH_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_SETUP_TOKEN=
