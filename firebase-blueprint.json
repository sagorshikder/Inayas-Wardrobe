{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "Furniture or custom wardrobe item in the Inaya's Wardrobe catalog.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "cat": { "type": "string", "minLength": 1, "maxLength": 60 },
        "price": { "type": "number" },
        "old": { "type": "number" },
        "desc": { "type": "string", "maxLength": 1200 },
        "tag": { "type": "string", "maxLength": 40 },
        "rating": { "type": "number" },
        "reviews": { "type": "number" },
        "image": { "type": "string", "maxLength": 950000 },
        "thumb": { "type": "string", "maxLength": 450000 },
        "images": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "cat", "price", "createdAt"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer furniture order with delivery address and payment method.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "minLength": 1, "maxLength": 100 },
        "phone": { "type": "string", "minLength": 10, "maxLength": 24 },
        "address": { "type": "string", "minLength": 3, "maxLength": 300 },
        "note": { "type": "string", "maxLength": 400 },
        "paymentMethod": { "type": "string", "enum": ["COD", "bKash", "Nagad", "Rocket", "IBBL"] },
        "total": { "type": "number" },
        "status": { "type": "string", "enum": ["New", "Confirmed", "Delivered", "Cancelled"] },
        "items": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "phone", "address", "paymentMethod", "total", "status", "items", "createdAt"]
    },
    "Review": {
      "title": "Review",
      "description": "Verified customer review displayed on the storefront.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "text": { "type": "string", "minLength": 1, "maxLength": 600 },
        "stars": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "text", "stars", "createdAt"]
    },
    "GalleryItem": {
      "title": "GalleryItem",
      "description": "Real-home furniture installation showcase photo.",
      "type": "object",
      "properties": {
        "cat": { "type": "string", "minLength": 1, "maxLength": 60 },
        "title": { "type": "string", "maxLength": 120 },
        "image": { "type": "string", "minLength": 1, "maxLength": 950000 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["image", "createdAt"]
    },
    "Inquiry": {
      "title": "Inquiry",
      "description": "Customer custom design or contact inquiry submitted via the storefront.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 100 },
        "phone": { "type": "string", "minLength": 10, "maxLength": 24 },
        "interest": { "type": "string", "minLength": 1, "maxLength": 80 },
        "message": { "type": "string", "maxLength": 800 },
        "status": { "type": "string", "enum": ["New", "Contacted", "Closed"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "phone", "interest", "status", "createdAt"]
    },
    "SiteSetting": {
      "title": "SiteSetting",
      "description": "Storefront configurable copy and image overrides.",
      "type": "object",
      "properties": {
        "t": { "type": "object" },
        "data": { "type": "string", "maxLength": 950000 },
        "hero": { "type": "string", "maxLength": 950000 },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "Registered user profile linked by Firebase Auth UID.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "displayName": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "maxLength": 160 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email"]
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": { "$ref": "#/entities/Product" },
      "description": "Storefront furniture and wardrobe catalog items."
    },
    "/orders/{orderId}": {
      "schema": { "$ref": "#/entities/Order" },
      "description": "Customer orders with PII protected to admin and owning signed-in user."
    },
    "/reviews/{reviewId}": {
      "schema": { "$ref": "#/entities/Review" },
      "description": "Customer testimonials displayed on the homepage."
    },
    "/gallery/{itemId}": {
      "schema": { "$ref": "#/entities/GalleryItem" },
      "description": "Completed project photos in real homes."
    },
    "/inquiries/{inquiryId}": {
      "schema": { "$ref": "#/entities/Inquiry" },
      "description": "Custom design and contact inquiries."
    },
    "/settings/{settingId}": {
      "schema": { "$ref": "#/entities/SiteSetting" },
      "description": "Configurable hero, contact, and category media overrides."
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Private user profiles isolated by Firebase UID."
    }
  }
}
